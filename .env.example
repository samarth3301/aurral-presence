# Discord application ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=123456789012345678

# Aurral server and your Aurral account (Subsonic API uses account credentials, not API keys)
AURRAL_URL=https://aurral.example.com
AURRAL_USERNAME=your-username
AURRAL_PASSWORD=your-password

# Seconds between now-playing checks
POLL_INTERVAL_SECS=10

# listening | playing | watching | competing
ACTIVITY_TYPE=listening
# Text shown in the member list: name | state | details
STATUS_DISPLAY=details
# Overrides the Discord application name, e.g. "Listening to Aurral"
ACTIVITY_NAME=Aurral

# Placeholders: {title} {artist} {album} {year} {duration}
DETAILS_FORMAT={title}
STATE_FORMAT=by {artist}
LARGE_TEXT_FORMAT={album} ({year})

# Album art is looked up on the iTunes Search API; falls back to LARGE_IMAGE
SHOW_ARTWORK=true
SHOW_TIMESTAMPS=true
# Asset key uploaded under Rich Presence > Art Assets, or an image URL
LARGE_IMAGE=aurral
SMALL_IMAGE=
SMALL_TEXT=

# Up to two buttons; both label and URL are required for each
BUTTON1_LABEL=Open Aurral
BUTTON1_URL=https://music.aurral.org
BUTTON2_LABEL=
BUTTON2_URL=
