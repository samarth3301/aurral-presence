#!/bin/sh
subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].{0,71}$'

case "$subject" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit message does not follow the commit rules in CONTRIBUTING.md:" >&2
  echo "  $subject" >&2
  echo "expected: <type>(<optional scope>): <summary>, e.g. fix(aurral): treat an early save as a pause" >&2
  exit 1
fi
