# Copy to .env and fill in. Keep .env private; presence customization lives in config.json.

# Discord: https://discord.com/developers/applications > Create blank app
# General Information > Application ID
DISCORD_CLIENT_ID=123456789012345678

# Your Aurral server, without a trailing slash
AURRAL_URL=https://aurral.example.com

# Aurral > Settings > Profile > API access (your personal key).
# Not the key under Settings > General: that instance key belongs to no user and is refused with 403.
AURRAL_API_KEY=your-personal-api-key
