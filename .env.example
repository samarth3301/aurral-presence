# Secrets only. Presence customization lives in config.json.

# Discord application ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=123456789012345678

# Aurral server and your personal API key (Settings > Profile > API access).
# Use your own key, not the instance AURRAL_API_KEY: playback state is per user.
AURRAL_URL=https://aurral.example.com
AURRAL_API_KEY=your-api-key
